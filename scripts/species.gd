static func of_place(loc: String) -> Array[String]:
	var out: Array[String] = []
	for k in ALL:
		if ALL[k].loc == loc:
			out.append(k)
	out.sort_custom(func(a, b): return ALL[a].r < ALL[b].r or (ALL[a].r == ALL[b].r and ALL[a].price < ALL[b].price))
	return out


static func count() -> int:
	return ALL.size()


## The special visitor of a place, or "" if it has none.
static func special_of(loc: String) -> String:
	for k in ALL:
		if ALL[k].loc == loc and ALL[k].r == 4:
			return k
	return ""


static func legends() -> Array[String]:
	var out: Array[String] = []
	for k in ALL:
		if ALL[k].r == 3:
			out.append(k)
	return out
